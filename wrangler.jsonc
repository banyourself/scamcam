{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scamcam",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/ocr/*", "!/downloads/*", "!/favicon.svg", "!/favicon.ico", "!/robots.txt", "!/sitemap.xml",
      "!/og-image.png", "!/apple-touch-icon.png", "!/site.webmanifest", "!/icon-192.png", "!/icon-512.png",
      "!/icon-maskable-512.png", "!/.well-known/*", "!/security.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scamcam",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SCAN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "SHARE_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "FLAG_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "PASSWORD_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SCANNER", "class_name": "Scanner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scanner"] }],
  "triggers": {
    "crons": ["17 3 * * *", "41 4 * * 1", "*/5 * * * *"]
  },
  "vars": {
    "APP_ENV": "development",
    "APP_VERSION": "0.1.0",
    "STORAGE_SOFT_LIMIT_BYTES": "80000000",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "SAFE_BROWSING_DAILY_LIMIT": "8000",
    "URLHAUS_DAILY_LIMIT": "5000",
    "AI_MODE": "inconclusive",
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "AI_DAILY_LIMIT": "2000",
    "PHISHSTATS_DAILY_LIMIT": "140",
    "FLAG_DAILY_LIMIT": "200"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "env": {
    "production": {
      "name": "scamcam",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "scamcam.kevinle.tech", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "scamcam",
          "database_id": "bcd6fed8-7150-4f63-a661-d6e24ccfaee1",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "SCAN_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "SHARE_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "FLAG_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 3, "period": 60 }
        },
        {
          "name": "PASSWORD_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [{ "name": "SCANNER", "class_name": "Scanner" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scanner"] }],
      "triggers": {
        "crons": ["17 3 * * *", "41 4 * * 1", "*/5 * * * *"]
      },
      "vars": {
        "APP_ENV": "production",
        "APP_VERSION": "0.1.0",
        "STORAGE_SOFT_LIMIT_BYTES": "80000000",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFO_YoUQA-ehFN5P",
        "SAFE_BROWSING_DAILY_LIMIT": "8000",
        "URLHAUS_DAILY_LIMIT": "5000",
        "AI_MODE": "inconclusive",
        "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
        "AI_DAILY_LIMIT": "2000",
        "PHISHSTATS_DAILY_LIMIT": "140",
        "FLAG_DAILY_LIMIT": "200"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": false
        }
      }
    }
  }
}
