{
  "name": "scamcam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pack-extension.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test \"test/node/*.test.ts\"",
    "db:migrate:local": "wrangler d1 migrations apply scamcam --local",
    "cf-typegen": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "check": "npm run typecheck && npm test && npm run build",
    "test:worker": "vitest run",
    "test:config": "node --test \"test/node/*.test.ts\"",
    "test:a11y": "vite build && node scripts/a11y.ts",
    "test:privacy": "vite build && node scripts/privacy-check.ts",
    "test:recovery": "node scripts/recovery-drill.ts",
    "lists:build": "node scripts/domain-list.ts",
    "lists:sync": "bash scripts/sync-lists.sh",
    "brands:wikidata": "node scripts/wikidata-brands.ts",
    "flags": "node scripts/flags.ts",
    "deploy": "node scripts/deploy.ts",
    "deploy:dry-run": "node scripts/deploy.ts --dry-run",
    "check:live": "node scripts/privacy-check.ts --live https://scamcam.kevinle.tech"
  },
  "dependencies": {
    "@fontsource/big-shoulders-stencil-display": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hono/zod-openapi": "1.6.3",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "jsqr": "1.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "tldts": "7.4.16",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/vitest-plugin": "1.3.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
